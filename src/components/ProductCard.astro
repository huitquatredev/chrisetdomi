---
import { categoryLabel, formatPrice, type Product } from '../data/products';

type Props = {
  product: Product;
  index?: number;
  eager?: boolean;
};

const { product, index = 0, eager = false } = Astro.props;
const category = categoryLabel(product.category);
---

<article
  class="card"
  data-product
  data-category={product.category}
  data-search={`${product.name} ${product.producer} ${product.appellation} ${product.region} ${product.type} ${product.vintage ?? ''}`.toLowerCase()}
  data-reveal
  style={`--reveal-delay:${Math.min(index, 7) * 55}ms`}
>
  <a class="card__link" href={`/catalogue/${product.slug}`} aria-label={`${product.name}, ${product.producer}, ${category}`}>
    <div class="card__media">
      {product.badge && <span class="card__badge">{product.badge}</span>}
      <span class="card__type">{product.type}</span>
      <img
        src={product.image}
        alt={`Bouteille — ${product.name}, ${product.producer}`}
        width="360"
        height="360"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span class="card__shadow" aria-hidden="true"></span>
    </div>

    <div class="card__body">
      <p class="card__producer">{product.producer} <span aria-hidden="true">·</span> {product.region}</p>
      <h3 class="card__name">{product.name}</h3>
      <p class="card__meta">
        {product.appellation}{product.vintage ? ` · ${product.vintage}` : ''}
      </p>

      <div class="card__foot">
        <span class="price">{formatPrice(product.price)}<small>ind.</small></span>
        <span class="card__arrow" aria-hidden="true">
          <svg viewBox="0 0 18 18" fill="none">
            <path d="M4 14L14 4M6 4h8v8" stroke="currentColor" stroke-width="1.1" />
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
    height: 100%;
    background: var(--cream);
    border: 1px solid var(--line);
    transition:
      border-color 0.4s var(--ease-soft),
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .card:hover {
    border-color: rgba(92, 26, 43, 0.38);
    transform: translateY(-5px);
    box-shadow: 0 22px 46px -30px rgba(36, 18, 22, 0.45);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card__media {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 254px;
    padding: 24px 20px 18px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 82%, rgba(255, 252, 246, 0.9) 0%, rgba(236, 227, 212, 0) 62%),
      linear-gradient(180deg, #f2ecdf 0%, #ece3d4 100%);
  }

  .card__media::before {
    content: '';
    position: absolute;
    inset: 13px;
    border: 1px solid rgba(36, 18, 22, 0.07);
    pointer-events: none;
  }

  .card__media img {
    position: relative;
    z-index: 1;
    width: auto;
    max-width: 82%;
    height: 198px;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.8s var(--ease-out);
  }

  .card:hover .card__media img {
    transform: translateY(-4px) scale(1.035);
  }

  .card__shadow {
    position: absolute;
    left: 50%;
    bottom: 17px;
    width: 58%;
    height: 10px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(49, 24, 19, 0.14) 0%, rgba(49, 24, 19, 0) 70%);
  }

  .card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 5px 8px 4px;
    background: var(--wine);
    color: var(--cream);
    font-size: 7.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
  }

  .card__type {
    position: absolute;
    top: 17px;
    right: 16px;
    z-index: 2;
    max-width: 45%;
    font-size: 7.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
    text-align: right;
    color: var(--muted);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 20px 18px;
  }

  .card__producer {
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.17em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--wine);
  }

  .card__producer span {
    opacity: 0.5;
  }

  .card__name {
    margin-top: 8px;
    font-size: clamp(1.35rem, 1.6vw, 1.62rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .card__meta {
    margin-top: 7px;
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--muted);
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 18px;
  }

  .card__foot::before {
    content: none;
  }

  .card__arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    color: var(--wine);
    transition:
      background 0.35s var(--ease-soft),
      color 0.35s var(--ease-soft),
      border-color 0.35s var(--ease-soft),
      transform 0.35s var(--ease-out);
  }

  .card__arrow svg {
    width: 12px;
    height: 12px;
  }

  .card:hover .card__arrow {
    background: var(--wine);
    border-color: var(--wine);
    color: var(--cream);
    transform: translate(2px, -2px);
  }

  .price small {
    font-size: 7.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .card__media {
      height: 230px;
    }

    .card__media img {
      height: 176px;
    }
  }
</style>

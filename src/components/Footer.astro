---
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="shell">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="/" aria-label="Caveau Chris et Domi, accueil">
          <img src="/brand/logo-light.png" alt="Caveau Chris &amp; Domi — vins et spiritueux depuis 2012" width="332" height="227" />
        </a>
        <p class="footer__intro">
          Vins, champagnes, spiritueux et bières artisanales.<br />
          Une cave familiale à Orange depuis 2012.
        </p>
        <a class="footer__phone" href="tel:+33488848667">04 88 84 86 67</a>
        <a class="footer__mail" href="mailto:contact@caveaudechrisetdomi.com">contact@caveaudechrisetdomi.com</a>
      </div>

      <div class="footer__columns">
        <div class="footer__col">
          <p class="footer__heading">La cave</p>
          <a href="/#la-maison">La maison</a>
          <a href="/#selection">La sélection</a>
          <a href="/catalogue">Le catalogue</a>
          <a href="/#tireuses">Location de tireuses</a>
        </div>

        <div class="footer__col">
          <p class="footer__heading">Les univers</p>
          <a href="/catalogue?categorie=rouges">Vins rouges</a>
          <a href="/catalogue?categorie=blancs">Vins blancs</a>
          <a href="/catalogue?categorie=champagnes">Champagnes</a>
          <a href="/catalogue?categorie=spiritueux">Spiritueux</a>
          <a href="/catalogue?categorie=bieres">Bières</a>
        </div>

        <div class="footer__col footer__col--contact">
          <p class="footer__heading">Nous trouver</p>
          <address>
            500 avenue de Verdun<br />
            Lieu-dit Les Sables Ouest<br />
            84100 Orange
          </address>
          <a class="footer__itinerary" href="https://www.google.com/maps/search/?api=1&query=500+avenue+de+Verdun+84100+Orange" target="_blank" rel="noopener">
            Itinéraire
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 13L13 3M5 3h8v8" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </a>
          <p class="footer__hours">
            Lundi : 14h30–19h30<br />
            Mardi – vendredi : 9h30–13h / 14h30–19h30<br />
            Samedi : 9h30–19h30 · Dimanche : fermé
          </p>
        </div>
      </div>
    </div>

    <div class="footer__legal">
      <p>© {year} Caveau Chris et Domi — 84100 Orange</p>
      <p class="footer__mention">Photographies d’illustration · Prix indicatifs · Site de démonstration</p>
      <p class="footer__warning">
        L’abus d’alcool est dangereux pour la santé, à consommer avec modération.<br />
        La vente d’alcool aux mineurs est interdite.
      </p>
    </div>
  </div>

  <div class="footer__wordmark" aria-hidden="true">Chris &amp; Domi</div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--wine-black);
    color: rgba(251, 248, 242, 0.68);
    padding-top: clamp(58px, 7vw, 96px);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) 1.45fr;
    gap: clamp(50px, 8vw, 130px);
    padding-bottom: clamp(50px, 6vw, 80px);
  }

  .footer__logo {
    display: inline-block;
  }

  .footer__logo img {
    width: 218px;
    height: auto;
    opacity: 0.95;
  }

  .footer__intro {
    margin-top: 24px;
    max-width: 300px;
    font-size: 13.5px;
    line-height: 1.7;
    color: rgba(251, 248, 242, 0.52);
  }

  .footer__phone {
    display: inline-block;
    margin-top: 22px;
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.07em;
    line-height: 1;
    color: var(--cream);
    transition: color 0.3s;
  }

  .footer__phone:hover {
    color: var(--pink);
  }

  .footer__mail {
    display: block;
    margin-top: 9px;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: rgba(251, 248, 242, 0.48);
    transition: color 0.3s;
  }

  .footer__mail:hover {
    color: var(--cream);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
    font-size: 12.5px;
    line-height: 1.5;
  }

  .footer__heading {
    font-size: 8.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--pink);
    margin-bottom: 9px;
  }

  .footer__col a {
    color: rgba(251, 248, 242, 0.58);
    transition: color 0.3s;
  }

  .footer__col a:hover {
    color: var(--cream);
  }

  .footer__col address {
    font-style: normal;
    line-height: 1.7;
    color: rgba(251, 248, 242, 0.58);
  }

  .footer__itinerary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream) !important;
    border-bottom: 1px solid var(--line-light);
    padding-bottom: 3px;
    margin-top: 3px;
  }

  .footer__itinerary svg {
    width: 11px;
    height: 11px;
  }

  .footer__hours {
    margin-top: 12px;
    font-size: 10.5px;
    line-height: 1.8;
    color: rgba(251, 248, 242, 0.4);
  }

  .footer__legal {
    display: grid;
    grid-template-columns: 1fr auto 1.15fr;
    align-items: start;
    gap: 30px;
    border-top: 1px solid rgba(251, 248, 242, 0.12);
    padding-block: 24px 34px;
    font-size: 9.5px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: rgba(251, 248, 242, 0.38);
  }

  .footer__mention {
    text-align: center;
  }

  .footer__warning {
    text-align: right;
    font-size: 8.5px;
    letter-spacing: 0.08em;
    line-height: 1.8;
    text-transform: uppercase;
    color: rgba(251, 248, 242, 0.5);
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 16.5vw, 17rem);
    line-height: 0.7;
    letter-spacing: -0.04em;
    white-space: nowrap;
    text-align: center;
    color: rgba(251, 248, 242, 0.055);
    transform: translateY(0.14em);
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 960px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .footer__legal {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .footer__mention,
    .footer__warning {
      text-align: left;
    }
  }

  @media (max-width: 620px) {
    .footer__columns {
      grid-template-columns: 1fr 1fr;
      gap: 36px 24px;
    }

    .footer__col--contact {
      grid-column: 1 / -1;
    }

    .footer__logo img {
      width: 190px;
    }
  }
</style>
